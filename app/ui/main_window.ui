  <property name="styleSheet">
   <string notr="true">QMainWindow {
                background-color: #2E3440; /* Dark Nordic background */
            }
            QGroupBox {
                background-color: #3B4252; /* Slightly lighter Nordic background for group boxes */
                border: 1px solid #4C566A;
                border-radius: 8px;
                margin-top: 1ex; /* Space for title */
                font-weight: bold;
                color: #ECEFF4; /* Light text for titles */
            }
            QGroupBox::title {
                subcontrol-origin: margin;
                subcontrol-position: top center;
                padding: 0 5px;
                background-color: #434C5E;
                border-radius: 5px;
            }
            QLabel {
                color: #D8DEE9; /* Light gray text */
                font-size: 8pt;
            }
            QLabel#label_img, QLabel#label_img_predicted {
                border: 2px solid #4C566A;
                border-radius: 6px;
                background-color: #434C5E; /* Background for image areas */
            }
            QPushButton {
                background-color: #5E81AC; /* Nordic blue for buttons */
                color: #ECEFF4; /* Light text on buttons */
                border: none;
                padding: 8px 16px;
                border-radius: 4px;
                font-size: 8pt;
            }
            QPushButton:hover {
                background-color: #81A1C1; /* Lighter blue on hover */
            }
            QPushButton:pressed {
                background-color: #4C566A; /* Darker blue when pressed */
            }
            QTextEdit, QTextBrowser {
                background-color: #3B4252;
                color: #D8DEE9;
                border: 1px solid #4C566A;
                border-radius: 4px;
                padding: 5px;
                font-size: 10pt;
            }
            QListWidget {
                background-color: #3B4252;
                color: #D8DEE9;
                border: 1px solid #4C566A;
                border-radius: 4px;
                font-size: 8pt;
                alternate-background-color: #434C5E; /* For alternating row colors if enabled */
            }
            QListWidget::item {
                padding: 5px;
            }
            QListWidget::item:selected {
                background-color: #5E81AC; /* Selection color */
                color: #ECEFF4;
            }
            /* Specific styling for important labels */
            QLabel#label_tello_battery, QLabel#label_tello_current_height, QLabel#label_nowtime {
                font-weight: bold;
                color: #A3BE8C; /* Nordic green for positive status */
                font-size: 11pt;
            }
            QLabel#label_now_search_name {
                 font-style: italic;
                 color: #EBCB8B; /* Nordic yellow for emphasis */
            }</string>
  </property>
